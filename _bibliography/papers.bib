@inproceedings{xu2025haad,
  abbr        = {ACM MM},
  topic       = {privacy},
  bibtex_show = {true},
  title       = {An h-space Based Adversarial Attack for Protection Against Few-shot Personalization},
  author      = {Xu, Xide and Kamath, Sandesh and Butt, Muhammad Atif and Raducanu, Bogdan},
  booktitle   = {ACM International Conference on Multimedia (ACM MM)},
  year        = {2025},
  doi         = {10.1145/3746027.3755659},
  arxiv       = {2507.17554},
  preview     = {haad.jpg},
  abstract    = {HAAD is an anti-customization attack that builds adversarial perturbations in the h-space of diffusion models to degrade unauthorized few-shot personalization. A variant, HAAD-KV, builds perturbations only from the key and value parameters of the h-space, giving stronger protection at a lower computational cost.}
}

@article{butt2025r2s100k,
  abbr        = {IJCV},
  topic       = {driving, benchmark},
  bibtex_show = {true},
  title       = {R2S100K: Road-Region Segmentation Dataset for Semi-Supervised Autonomous Driving in the Wild},
  author      = {Butt, Muhammad Atif and Ali, Hassan and Qayyum, Adnan and Sultani, Waqas and Al-Fuqaha, Ala and Qadir, Junaid},
  journal     = {International Journal of Computer Vision (IJCV)},
  year        = {2025},
  doi         = {10.1007/s11263-024-02207-3},
  arxiv       = {2308.06393},
  code        = {https://github.com/moatifbutt/r2s100k},
  website     = {https://r2s100k.github.io/},
  preview     = {r2s100k.jpg},
  abstract    = {R2S100K is a large-scale dataset and benchmark for road-region segmentation on unstructured roads. It contains 100K images from video sequences covering more than 1000 km of roadways, with 14K finely labeled images and 86K unlabeled images for semi-supervised learning, and distinguishes safe asphalt from atypical surfaces such as potholes, water puddles, gravel, and earthen patches. A self-training framework based on Efficient Data Sampling exploits the unlabeled data.}
}

% ---------------------------------------------------------------- 2024

@inproceedings{butt2024colorpeel,
  abbr        = {ECCV},
  topic       = {color},
  selected    = {true},
  bibtex_show = {true},
  title       = {ColorPeel: Color Prompt Learning with Diffusion Models via Color and Shape Disentanglement},
  author      = {Butt, Muhammad Atif and Wang, Kai and Vazquez-Corral, Javier and {van de Weijer}, Joost},
  booktitle   = {European Conference on Computer Vision (ECCV)},
  year        = {2024},
  doi         = {10.1007/978-3-031-72667-5_26},
  arxiv       = {2407.07197},
  html        = {https://www.ecva.net/papers/eccv_2024/papers_ECCV/html/1191_ECCV_2024_paper.php},
  code        = {https://github.com/moatifbutt/color-peel},
  website     = {/projects/colorpeel/},
  preview     = {colorpeel.jpg},
  abstract    = {Text-to-image models accept color names, but names cover wide ranges, so matching an exact color is hard, and existing personalization methods entangle color with object shape. ColorPeel generates simple 2D and 3D geometric shapes in the target color and learns a color prompt from them, explicitly disentangling color from shape so that the learned token carries color alone. The approach extends to abstract attributes such as textures and materials.}
}

@inproceedings{xu2024copsam,
  abbr        = {NeurIPS-W},
  topic       = {privacy},
  bibtex_show = {true},
  title       = {Privacy Protection in Personalized Diffusion Models via Targeted Cross-Attention Adversarial Attack},
  author      = {Xu, Xide and Butt, Muhammad Atif and Kamath, Sandesh and Raducanu, Bogdan},
  booktitle   = {NeurIPS Workshop on Safe Generative AI},
  year        = {2024},
  arxiv       = {2411.16437},
  preview     = {copsam.jpg},
  abstract    = {CoPSAM (Concept Protection by Selective Attention Manipulation) protects user images against unauthorized personalization by targeting only the cross-attention layers of a text-to-image diffusion model, maximizing the discrepancy between the attention maps of the user-specific token and the class-specific token.}
}

