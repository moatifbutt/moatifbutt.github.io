@inproceedings{wang2023dpl,
  abbr        = {NeurIPS},
  topic       = {editing},
  bibtex_show = {true},
  title       = {Dynamic Prompt Learning: Addressing Cross-Attention Leakage for Text-Based Image Editing},
  author      = {Wang, Kai and Yang, Fei and Yang, Shiqi and Butt, Muhammad Atif and {van de Weijer}, Joost},
  booktitle   = {Advances in Neural Information Processing Systems (NeurIPS)},
  year        = {2023},
  arxiv       = {2309.15664},
  html        = {https://proceedings.neurips.cc/paper_files/paper/2023/hash/5321b1dabcd2be188d796c21b733e8c7-Abstract.html},
  code        = {https://github.com/wangkai930418/DPL},
  preview     = {dpl.jpg},
  abstract    = {Text-based image editing often makes unintended changes to the background or to distractor objects. We show that inaccurate cross-attention maps are at the root of this problem and propose Dynamic Prompt Learning (DPL), which forces cross-attention maps to focus on the correct noun words in the prompt, enabling fine-grained edits of particular objects while preventing undesired changes elsewhere.}
}

