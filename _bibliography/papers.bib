@article{butt2026kansteer,
  abbr        = {Preprint},
  topic       = {interpretability},
  selected    = {true},
  bibtex_show = {true},
  title       = {Beyond the Linear Representation Hypothesis: Non-Linear Activation Steering in Text-to-Image Models},
  author      = {Butt, Muhammad Atif and Skier{\'s}, Pawe{\l} and {van de Weijer}, Joost and Deja, Kamil},
  journal     = {arXiv preprint},
  year        = {2026},
  arxiv       = {2610.06945},
  preview     = {kansteer.jpg},
  abstract    = {Mechanistic interpretability often relies on the Linear Representation Hypothesis, which assumes that high-level concepts are encoded as linear directions in activation space. Yet natural visual concepts often pass through genuine intermediate states, and when text-to-image models are prompted for intermediate attributes, their activations rarely fall on the straight line connecting the endpoints. KANSteer models concept traversal as a curve through these intermediate states using Kolmogorov-Arnold Networks, which provide a one-dimensional coordinate whose learned functions define the trajectory, so the steering direction varies along the concept while remaining interpretable. Across several concepts and text-to-image diffusion transformers, activation trajectories deviate substantially from straight lines, and KANSteer provides a closer fit and smoother traversal of intermediate attributes than linear steering.}
}

@inproceedings{butt2026numcolor,
  abbr        = {ECCV},
  topic       = {color},
  selected    = {true},
  bibtex_show = {true},
  title       = {NumColor: Precise Numeric Color Control in Text-to-Image Generation},
  author      = {Butt, Muhammad Atif and Hern{\'a}ndez, Diego and Gomez-Villa, Alexandra and Wang, Kai and Vazquez-Corral, Javier and {van de Weijer}, Joost},
  booktitle   = {European Conference on Computer Vision (ECCV)},
  year        = {2026},
  doi         = {10.1007/978-3-032-37211-6_9},
  arxiv       = {2603.13547},
  code        = {https://github.com/moatifbutt/numcolor},
  website     = {/projects/numcolor/},
  preview     = {numcolor.jpg},
  abstract    = {Text-to-image diffusion models struggle with numerical color specifications such as hex codes and RGB values, because subword tokenization splits color codes into fragments the text encoder cannot map to consistent colors. NumColor introduces a Color Token Aggregator that detects color specifications regardless of tokenization and a ColorBook of 6,707 learnable embeddings aligned with CIE Lab space, together with auxiliary losses that keep the Lab and embedding geometries consistent. Trained on NumColor-Data, a synthetic set of 500K rendered images with exact color-to-pixel correspondence, the model is trained only on FLUX and transfers zero-shot to SD3, SD3.5, and PixArt models.}
}

@inproceedings{butt2026gencolorbench,
  abbr        = {CVPR},
  topic       = {color, benchmark},
  selected    = {true},
  bibtex_show = {true},
  title       = {GenColorBench: A Color Evaluation Benchmark for Text-to-Image Generation Models},
  author      = {Butt, Muhammad Atif and Gomez-Villa, Alexandra and Wu, Tao and Vazquez-Corral, Javier and {van de Weijer}, Joost and Wang, Kai},
  booktitle   = {IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)},
  year        = {2026},
  arxiv       = {2510.20586},
  html        = {https://openaccess.thecvf.com/content/CVPR2026/html/Butt_GenColorBench_A_Color_Evaluation_Benchmark_for_Text-to-Image_Generation_CVPR_2026_paper.html},
  code        = {https://github.com/moatifbutt/gen-color-bench},
  website     = {/projects/gencolorbench/},
  preview     = {gencolorbench.jpg},
  abstract    = {Recent text-to-image models still struggle with fine-grained color controllability and often fail to match the colors specified in prompts. GenColorBench is a benchmark of about 44K color-focused prompts covering more than 400 colors, grounded in color systems such as ISCC-NBS and CSS3/X11 and including numerical colors. It evaluates five tasks (color name understanding, multi-color composition, color-object association, numeric color understanding, and implicit color association) by combining VQA with perceptual color metrics.}
}

@inproceedings{butt2026lumictrl,
  abbr        = {CVPR-W},
  topic       = {color},
  selected    = {true},
  bibtex_show = {true},
  award       = {Oral},
  award_name  = {Oral},
  title       = {LumiCtrl: Learning Illuminant Prompts for Lighting Control in Personalized Text-to-Image Models},
  author      = {Butt, Muhammad Atif and Wang, Kai and Vazquez-Corral, Javier and {van de Weijer}, Joost},
  booktitle   = {IEEE/CVF CVPR Workshop on Computer Vision for Editing (CVEU)},
  year        = {2026},
  html        = {https://openaccess.thecvf.com/content/CVPR2026W/CVEU/html/Butt_LumiCtrl_Learning_Illuminant_Prompts_for_Lighting_Control_in__Personalized_CVPRW_2026_paper.html},
  arxiv       = {2512.17489},
  website     = {/projects/lumictrl/},
  preview     = {lumictrl.jpg},
  abstract    = {Text-to-image models lack precise control over illumination. LumiCtrl learns an illuminant prompt from a single image of an object using three components: physics-based illuminant augmentation along the Planckian locus, edge-guided prompt disentanglement with a frozen ControlNet so that the prompt captures light rather than structure, and a masked reconstruction loss that focuses learning on the foreground while letting the background adapt.}
}

@inproceedings{laria2026colorwave,
  abbr        = {WACV},
  topic       = {color},
  bibtex_show = {true},
  title       = {Leveraging Semantic Attribute Binding for Free-Lunch Color Control in Diffusion Models},
  author      = {Laria, H{\'e}ctor and Gomez-Villa, Alexandra and Qin, Jiang and Butt, Muhammad Atif and Raducanu, Bogdan and Vazquez-Corral, Javier and {van de Weijer}, Joost and Wang, Kai},
  booktitle   = {IEEE/CVF Winter Conference on Applications of Computer Vision (WACV)},
  year        = {2026},
  html        = {https://openaccess.thecvf.com/content/WACV2026/html/Laria_Leveraging_Semantic_Attribute_Binding_for_Free-Lunch_Color_Control_in_Diffusion_WACV_2026_paper.html},
  doi         = {10.1109/WACV61042.2026.00742},
  arxiv       = {2503.09864},
  preview     = {colorwave.jpg},
  abstract    = {ColorWave is a training-free method for RGB-level color control in diffusion models. It shows that the cross-attention layers of IP-Adapter implicitly bind color words in the prompt to colors in a reference image, and rewires these bindings to attach the intended color to the intended object without any per-color optimization.}
}

